# Burstpoint Environment Configuration Template
# Copy this file to .env and fill in credentials for live platform publishing.

# Environment Mode: development | production | test
NODE_ENV=development

# Headless Browser & Render Configuration
CHROME_BIN=C:\Program Files\Google\Chrome\Application\chrome.exe
RENDER_FPS=60
RENDER_WIDTH=1080
RENDER_HEIGHT=1920
DEFAULT_VIDEO_DURATION=20.0

# Publishing: YouTube Data API v3 OAuth Credentials
# Required only for LIVE publishing (DRY_RUN works offline with zero credentials)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_DEFAULT_PRIVACY=private

# Publishing Cadence & Storage
PUBLISHING_TIMEZONE=UTC
DEFAULT_QUEUE_PATH=output/publishing_queue.json
DEFAULT_OUTPUT_DIR=output

# Audio & Voice Commentary
AUDIO_MODE=A
# Audio Modes:
# A = Pure physics / ASMR
# B = Minimal commentator
# C = Full commentary
TTS_PROVIDER=local_mock
